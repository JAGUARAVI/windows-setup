{
    "$schema":  "https://raw.githubusercontent.com/LGUG2Z/komorebi/v0.1.41/schema.json",
    "app_specific_configuration_path":  "$Env:USERPROFILE/applications.json",
    "window_hiding_behaviour":  "Cloak",
    "cross_monitor_move_behaviour":  "Swap",
    "default_workspace_padding":  8,
    "default_container_padding":  8,
    "border":  true,
    "border_width":  1,
    "border_offset":  0,
    "border_style":  "Rounded",
    "border_implementation":  "Windows",
    "border_colours":  {
                           "single":  "#C9A7FF",
                           "stack":  "#FFB3D9",
                           "monocle":  "#9CC7FF",
                           "floating":  "#B8F0D0",
                           "unfocused":  "#3A3152",
                           "unfocused_locked":  "#4A3F68"
                       },
    "transparency":  false,
    "transparency_alpha":  235,
    "animation":  {
                      "enabled":  true,
                      "duration":  160,
                      "style":  "EaseOutCubic",
                      "fps":  60,
                      "ghost_movement":  true
